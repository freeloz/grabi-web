---
import { SITE, type Locale } from '../config';
import { dictionaries } from '../i18n';
import Mascot from './Mascot.astro';
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = dictionaries[lang];
---
<section class="pair">
  <div class="card oss">
    <span class="eyebrow">{t.oss.eyebrow}</span>
    <h3>{t.oss.title}</h3>
    <div class="repo">
      <span class="name">freeloz/grabi</span>
      <span class="badge">MIT</span>
      <span class="badge">★ <span data-stars>—</span></span>
      <span class="badge">Swift</span>
    </div>
    <div class="btns">
      <a class="solid" href={SITE.githubApp} data-event="github_click" data-section="oss" rel="noopener" target="_blank">{t.oss.code}</a>
      <a class="ghost" href={`${SITE.githubApp}/blob/main/CONTRIBUTING.md`} data-event="github_click" data-section="oss-contribute" rel="noopener" target="_blank">{t.oss.contribute}</a>
      <a class="ghost" href={SITE.githubIssues} data-event="github_click" data-section="oss-bug" rel="noopener" target="_blank">{t.oss.bug}</a>
    </div>
  </div>
  <div class="donate">
    <Mascot pose="happy" size={56} />
    <h3>{t.donate.title}</h3>
    <div class="btns">
      <a class="coffee" href={SITE.coffee} data-event="donate_click" data-section="coffee" rel="noopener" target="_blank">{t.donate.coffee}</a>
      <a class="sponsor" href={SITE.sponsors} data-event="donate_click" data-section="sponsors" rel="noopener" target="_blank">{t.donate.sponsors}</a>
    </div>
  </div>
</section>
<style>
  .pair { display: grid; grid-template-columns: 1.3fr 1fr; gap: 18px; }
  @media (max-width: 820px) { .pair { grid-template-columns: 1fr; } }
  .oss { padding: 32px; display: flex; flex-direction: column; gap: 16px; }
  h3 { font-size: clamp(22px, 3vw, 26px); font-weight: 740; margin: 0; }
  .repo { border: 1px solid var(--border); border-radius: var(--r-md); padding: 16px 18px; display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .name { font-family: var(--font-mono); font-size: 14px; font-weight: 600; }
  .badge { font-size: 12px; font-weight: 600; background: var(--chip); border-radius: var(--r-full); padding: 4px 10px; color: var(--text2); }
  .btns { display: flex; gap: 10px; flex-wrap: wrap; margin-top: auto; }
  .btns a { height: 38px; padding: 0 18px; border-radius: var(--r-full); font-size: 13.5px; font-weight: 600; display: inline-flex; align-items: center; gap: 7px; text-decoration: none; }
  .solid { background: var(--text); color: var(--bg); }
  .ghost { border: 1px solid var(--border2); color: var(--text); }
  /* Donations card: fixed warm ivory in both themes, per Fase 5B */
  .donate { background: var(--warm-card); border: 1px solid var(--warm-card-border); border-radius: var(--r-xl); padding: 32px; display: flex; flex-direction: column; gap: 14px; }
  .donate :global(svg circle[fill="var(--rec)"]) { fill: #E5483F; }
  .donate :global(svg [fill="var(--bg)"]) { fill: #FFF6F0; }
  .donate :global(svg [stroke="var(--bg)"]) { stroke: #FFF6F0; }
  .donate h3 { color: #26221C; }
  .coffee { background: #26221C; color: #FAF7F1; }
  .sponsor { border: 1px solid #D8CDB8; color: #26221C; }
</style>
