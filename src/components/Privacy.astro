---
/* The only dark-on-both-themes section: deliberate seriousness, no mascot. */
import { type Locale } from '../config';
import { dictionaries } from '../i18n';
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = dictionaries[lang];
const icons = ['lock', 'user', 'nosignal', 'code'];
---
<section class="priv">
  <div class="head">
    <span class="eyebrow">{t.privacy.eyebrow}</span>
    <h2>{t.privacy.title}</h2>
  </div>
  <div class="grid">
    {t.privacy.items.map((item, i) => (
      <div class="item">
        <span class="ic">
          {icons[i] === 'lock' && <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="var(--exito-on-ink)" stroke-width="2" stroke-linecap="round"><rect x="5" y="10" width="14" height="10" rx="2.5"/><path d="M8 10 V7 a4 4 0 0 1 8 0 v3"/></svg>}
          {icons[i] === 'user' && <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="var(--exito-on-ink)" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="9" r="4"/><path d="M5 20 a7 7 0 0 1 14 0"/></svg>}
          {icons[i] === 'nosignal' && <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="var(--exito-on-ink)" stroke-width="2" stroke-linecap="round"><path d="M4 4 l16 16"/><path d="M4 12 a11 11 0 0 1 5 -8 M20 12 a11 11 0 0 0 -3 -6"/><circle cx="12" cy="17" r="1.4" fill="var(--exito-on-ink)" stroke="none"/></svg>}
          {icons[i] === 'code' && <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="var(--exito-on-ink)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6 L4 12 l5 6"/><path d="M15 6 l5 6 -5 6"/></svg>}
        </span>
        <strong>{item.title}</strong>
        <span class="txt">{item.text}</span>
      </div>
    ))}
  </div>
  <p class="foot">{t.privacy.footnote}</p>
</section>
<style>
  .priv { background: var(--ink); border-radius: 24px; padding: 56px 48px; display: flex; flex-direction: column; gap: 32px; }
  .head { display: flex; flex-direction: column; gap: 12px; max-width: 640px; }
  .eyebrow { color: var(--rec-on-ink); }
  h2 { font-size: clamp(28px, 4vw, 38px); line-height: 1.12; font-weight: 750; margin: 0; color: var(--ivory); }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 22px; }
  .item { display: flex; flex-direction: column; gap: 8px; }
  .ic { width: 34px; height: 34px; border-radius: 10px; background: var(--ink-soft); display: inline-flex; align-items: center; justify-content: center; }
  strong { font-size: 15px; color: var(--ivory); }
  .txt { font-size: 13.5px; line-height: 1.55; color: var(--ivory-dim); }
  .foot { margin: 0; font-size: 13.5px; color: var(--ivory-dim); border-top: 1px solid var(--ink-border); padding-top: 20px; }
  @media (max-width: 640px) { .priv { padding: 36px 24px; border-radius: var(--r-lg); } }
</style>
