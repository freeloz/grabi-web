---
import { type Locale } from '../config';
import { dictionaries } from '../i18n';
import Mascot from './Mascot.astro';
import DownloadButton from './DownloadButton.astro';
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = dictionaries[lang];
---
<section class="cta">
  <Mascot pose="celebrate" size={96} />
  <h2>{t.cta.title}</h2>
  <DownloadButton label={t.cta.button} section="final-cta" />
  <span class="meta">{t.cta.meta}</span>
</section>
<style>
  .cta { display: flex; flex-direction: column; align-items: center; gap: 20px; text-align: center; padding-top: 24px; }
  h2 { font-size: clamp(32px, 5vw, 46px); line-height: 1.08; font-weight: 760; margin: 0; max-width: 640px; }
  .meta { font-size: 13px; color: var(--text2); }
</style>
