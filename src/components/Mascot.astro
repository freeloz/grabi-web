---
/* Grabi mascot — poses ported 1:1 from the brand manual SVGs (viewBox 96).
   Body is always a perfect circle in --rec; face takes the page background. */
interface Props { pose?: 'neutral' | 'happy' | 'celebrate' | 'sad' | 'wave' | 'focused'; size?: number; class?: string }
const { pose = 'neutral', size = 56, class: cls } = Astro.props;
---
<svg viewBox="0 0 96 96" width={size} height={size} class={cls} aria-hidden="true">
  {pose === 'wave' && <><path d="M73 52 q13 -5 11 -20" fill="none" stroke="var(--rec)" stroke-width="7" stroke-linecap="round"/><circle cx="84" cy="30" r="5.5" fill="var(--rec)"/></>}
  {pose === 'celebrate' && <><circle cx="24" cy="18" r="3" fill="#E8B23A"/><circle cx="72" cy="14" r="3.5" fill="var(--rec)"/><circle cx="80" cy="34" r="2.5" fill="#E8B23A"/><circle cx="16" cy="38" r="2.5" fill="var(--rec)"/></>}
  <circle cx="48" cy="50" r="30" fill="var(--rec)"/>
  {(pose === 'neutral') && <><circle cx="40" cy="45" r="4.2" fill="var(--bg)"/><circle cx="56" cy="45" r="4.2" fill="var(--bg)"/><rect x="41" y="58" width="14" height="5.5" rx="2.75" fill="var(--bg)"/></>}
  {(pose === 'happy') && <><circle cx="40" cy="45" r="4.2" fill="var(--bg)"/><circle cx="56" cy="45" r="4.2" fill="var(--bg)"/><path d="M38 57 q10 11 20 0" fill="none" stroke="var(--bg)" stroke-width="5" stroke-linecap="round"/></>}
  {(pose === 'celebrate' || pose === 'wave') && <><path d="M35 45 q5 -7 10 0" fill="none" stroke="var(--bg)" stroke-width="3.5" stroke-linecap="round"/><path d="M51 45 q5 -7 10 0" fill="none" stroke="var(--bg)" stroke-width="3.5" stroke-linecap="round"/><path d="M39 57 q9 11 18 0" fill="none" stroke="var(--bg)" stroke-width="4" stroke-linecap="round"/></>}
  {pose === 'sad' && <><path d="M36 42 l8 7 M44 42 l-8 7" fill="none" stroke="var(--bg)" stroke-width="3.2" stroke-linecap="round"/><path d="M52 42 l8 7 M60 42 l-8 7" fill="none" stroke="var(--bg)" stroke-width="3.2" stroke-linecap="round"/><circle cx="48" cy="62" r="3.8" fill="var(--bg)"/></>}
  {pose === 'focused' && <><rect x="35.5" y="43" width="9" height="4.5" rx="2.25" fill="var(--bg)"/><rect x="51.5" y="43" width="9" height="4.5" rx="2.25" fill="var(--bg)"/><rect x="42" y="58" width="12" height="5" rx="2.5" fill="var(--bg)"/></>}
</svg>
