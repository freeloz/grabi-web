---
/* La vitrina de Grabi Cloud: qué es, cómo funciona, planes y preguntas.
   El framing opt-in va primero y con peso — la promesa de la marca sigue
   siendo "todo local"; la nube es un botón que el usuario elige. */
import { SITE, pathFor, type Locale } from '../config';
import { dictionaries } from '../i18n';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import Mascot from './Mascot.astro';
import Faq from './Faq.astro';
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = dictionaries[lang];
const c = t.cloudPage;
const signup = `${SITE.appUrl}/login`;
---
<Nav lang={lang} page="cloud" />
<main id="main">
  <div class="container-narrow sections">
    <header class="hero">
      <span class="eyebrow">{c.eyebrow}</span>
      <h1>{c.title}</h1>
      <p class="sub">{c.sub}</p>
      <a class="cta" href={signup} data-event="cloud_signup" data-section="hero">{c.cta}</a>
      <span class="cta-note">{c.ctaNote}</span>
    </header>

    <section class="optin card">
      <Mascot pose="happy" size={64} />
      <div>
        <h2>{c.optIn.title}</h2>
        <p>{c.optIn.text}</p>
      </div>
    </section>

    <section class="steps">
      {c.steps.map((step, i) => (
        <div class="card step">
          <span class="num">{i + 1}</span>
          <strong>{step.title}</strong>
          <p>{step.text}</p>
        </div>
      ))}
    </section>

    <section id="planes" class="plans">
      <div class="head">
        <span class="eyebrow">{c.plansTitle}</span>
        <h2>{c.plansSub}</h2>
        <div class="cycle" role="group">
          <button type="button" data-cycle="monthly">{c.monthly}</button>
          <button type="button" class="on" data-cycle="annual">{c.annual} · {c.annualNote}</button>
        </div>
      </div>

      <div class="grid">
        <div class="card plan">
          <span class="name">{c.free.name}</span>
          <span class="price">{c.free.price}</span>
          <span class="per">{c.free.note}</span>
          <ul>{c.free.features.map((f) => <li>{f}</li>)}</ul>
          <a class="btn ghost" href={signup} data-event="cloud_signup" data-section="plan_free">{c.cta}</a>
        </div>

        <div class="card plan featured">
          <span class="badge">{c.pro.badge}</span>
          <span class="name">{c.pro.name}</span>
          <span class="price"><span data-price-pro>{c.pro.annual}</span> <small>COP</small></span>
          <span class="per" data-per>{c.perYear}</span>
          <ul>{c.pro.features.map((f) => <li>{f}</li>)}</ul>
          <a class="btn" href={signup} data-event="cloud_signup" data-section="plan_pro">{c.cta}</a>
        </div>

        <div class="card plan">
          <span class="name">{c.student.name}</span>
          <span class="price"><span data-price-student>{c.student.annual}</span> <small>COP</small></span>
          <span class="per" data-per>{c.perYear}</span>
          <span class="note">{c.student.note}</span>
          <ul>{c.student.features.map((f) => <li>{f}</li>)}</ul>
          <a class="btn ghost" href={signup} data-event="cloud_signup" data-section="plan_student">{c.cta}</a>
        </div>
      </div>
    </section>

    <Faq lang={lang} items={c.faq} title={c.faqTitle} />
  </div>
</main>
<Footer lang={lang} />

<script is:inline define:vars={{ prices: {
  pro: { monthly: c.pro.monthly, annual: c.pro.annual },
  student: { monthly: c.student.monthly, annual: c.student.annual },
  perMonth: c.perMonth, perYear: c.perYear,
} }}>
  var buttons = document.querySelectorAll('[data-cycle]');
  buttons.forEach(function (btn) {
    btn.addEventListener('click', function () {
      var cycle = btn.getAttribute('data-cycle');
      buttons.forEach(function (b) { b.classList.toggle('on', b === btn); });
      document.querySelector('[data-price-pro]').textContent = prices.pro[cycle];
      document.querySelector('[data-price-student]').textContent = prices.student[cycle];
      document.querySelectorAll('[data-per]').forEach(function (el) {
        el.textContent = cycle === 'annual' ? prices.perYear : prices.perMonth;
      });
    });
  });
</script>

<style>
  .sections { padding-block: 56px 80px; display: flex; flex-direction: column; gap: 72px; }
  @media (max-width: 640px) { .sections { padding-block: 40px 48px; gap: 56px; } }

  .hero { display: flex; flex-direction: column; align-items: center; gap: 14px; text-align: center; }
  .hero h1 { font-size: clamp(32px, 5.5vw, 48px); line-height: 1.06; font-weight: 780; margin: 0; max-width: 680px; }
  .hero .sub { font-size: 17px; line-height: 1.6; color: var(--text2); margin: 0; max-width: 620px; }
  .cta {
    margin-top: 6px; height: 48px; padding: 0 26px; display: inline-flex; align-items: center;
    background: var(--brand); color: var(--onbrand); border-radius: var(--r-full);
    font-weight: 650; font-size: 15px; text-decoration: none;
  }
  .cta:hover { background: var(--brandh); }
  .cta-note { font-size: 13px; color: var(--text2); }

  .optin { display: flex; gap: 20px; align-items: center; padding: 26px 28px; }
  .optin h2 { font-size: 18px; margin: 0 0 6px; }
  .optin p { margin: 0; font-size: 14.5px; line-height: 1.6; color: var(--text2); }
  @media (max-width: 560px) { .optin { flex-direction: column; text-align: center; } }

  .steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 18px; }
  .step { padding: 26px 24px; display: flex; flex-direction: column; gap: 10px; }
  .step .num {
    width: 30px; height: 30px; border-radius: 50%; background: var(--text); color: var(--bg);
    font-size: 14px; font-weight: 700; display: inline-flex; align-items: center; justify-content: center;
  }
  .step strong { font-size: 16px; }
  .step p { margin: 0; font-size: 14.5px; line-height: 1.55; color: var(--text2); }

  .plans { display: flex; flex-direction: column; gap: 30px; }
  .plans .head { display: flex; flex-direction: column; align-items: center; gap: 14px; text-align: center; }
  .plans h2 { font-size: clamp(24px, 3.6vw, 32px); line-height: 1.15; font-weight: 750; margin: 0; max-width: 560px; }
  .cycle { display: inline-flex; background: var(--surface); border: 1.5px solid var(--border); border-radius: var(--r-full); padding: 4px; }
  .cycle button {
    font: inherit; font-size: 13.5px; font-weight: 600; border: none; cursor: pointer;
    padding: 9px 18px; border-radius: var(--r-full); background: none; color: var(--text2);
  }
  .cycle button.on { background: var(--brand); color: var(--onbrand); }

  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 18px; align-items: start; }
  .plan { padding: 28px 24px; display: flex; flex-direction: column; gap: 8px; position: relative; }
  .plan.featured { border-color: var(--brand); box-shadow: 0 0 0 1px var(--brand); }
  .plan .badge {
    position: absolute; top: -11px; left: 50%; transform: translateX(-50%);
    background: var(--brand); color: var(--onbrand); font-size: 11px; font-weight: 700;
    letter-spacing: .04em; text-transform: uppercase; padding: 4px 12px; border-radius: var(--r-full);
  }
  .plan .name { font-size: 16px; font-weight: 700; }
  .plan .price { font-size: 30px; font-weight: 780; letter-spacing: -.02em; font-variant-numeric: tabular-nums; }
  .plan .price small { font-size: 14px; font-weight: 600; color: var(--text2); }
  .plan .per, .plan .note { font-size: 13px; color: var(--text2); }
  .plan ul { list-style: none; padding: 0; margin: 14px 0 18px; display: flex; flex-direction: column; gap: 9px; }
  .plan li { font-size: 14px; line-height: 1.5; color: var(--text2); padding-left: 22px; position: relative; }
  .plan li::before { content: '✓'; position: absolute; left: 0; color: var(--exito); font-weight: 700; }
  .plan .btn {
    margin-top: auto; height: 44px; display: inline-flex; align-items: center; justify-content: center;
    background: var(--brand); color: var(--onbrand); border-radius: var(--r-full);
    font-weight: 650; font-size: 14.5px; text-decoration: none;
  }
  .plan .btn:hover { background: var(--brandh); }
  .plan .btn.ghost { background: var(--surface); color: var(--brandStrong, var(--brand)); border: 1.5px solid var(--border2); }
  .plan .btn.ghost:hover { border-color: var(--brand); color: var(--brand); background: var(--surface); }
</style>
