---
import { type Locale } from '../config';
import { dictionaries } from '../i18n';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = dictionaries[lang];
---
<Nav lang={lang} page="changelog" />
<main id="main" class="container-narrow page">
  <h1>{t.changelog.title}</h1>
  <p class="intro">{t.changelog.intro}</p>
  <div class="entries">
    {t.changelog.entries.map((e, i) => (
      <article class="entry">
        <div class="meta">
          <span class:list={['v', { latest: i === 0 }]}>{e.version}</span>
          <time>{e.date}</time>
        </div>
        <ul>{e.notes.map((n) => <li>{n}</li>)}</ul>
      </article>
    ))}
  </div>
</main>
<Footer lang={lang} page="changelog" />
<style>
  .page { padding-block: 48px 80px; max-width: 720px; }
  h1 { font-size: clamp(34px, 5vw, 44px); font-weight: 760; margin: 0 0 10px; }
  .intro { color: var(--text2); font-size: 16px; margin: 0 0 40px; }
  .entries { display: flex; flex-direction: column; gap: 36px; }
  .meta { display: flex; gap: 10px; align-items: center; margin-bottom: 10px; }
  .v { font-size: 13px; font-weight: 700; background: var(--chip); color: var(--text); border-radius: var(--r-full); padding: 4px 12px; }
  .v.latest { background: var(--ink); color: var(--ivory); }
  time { font-size: 13px; color: var(--text2); }
  ul { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 8px; }
  li { font-size: 15px; line-height: 1.6; color: var(--text); }
</style>
