---
import { SITE, pathFor, type Locale } from '../config';
import { dictionaries } from '../i18n';
import Logo from './Logo.astro';
import LangPicker from './LangPicker.astro';
interface Props { lang: Locale; page?: string }
const { lang, page = '' } = Astro.props;
const t = dictionaries[lang];
const home = pathFor(lang);
---
<footer class="footer">
  <div class="container grid">
    <div class="brand">
      <Logo size={26} />
      <span class="tagline">{t.footer.tagline}</span>
      <LangPicker lang={lang} page={page} label={t.a11y.langSelector} up />
    </div>
    <nav class="col" aria-label={t.footer.product}>
      <strong>{t.footer.product}</strong>
      <a href={SITE.downloadUrl} data-event="download_click" data-section="footer" rel="noopener">{t.footer.download}</a>
      <a href={pathFor(lang, 'cloud')}>{t.footer.cloudLink}</a>
      <a href={pathFor(lang, 'changelog')}>{t.footer.changelog}</a>
      <a href={`${SITE.githubApp}/milestones`} rel="noopener" target="_blank">{t.footer.roadmap}</a>
      <a href={`${home === '/' ? '' : home}/#faq`}>{t.footer.faq}</a>
    </nav>
    <nav class="col" aria-label={t.footer.resources}>
      <strong>{t.footer.resources}</strong>
      <a href={SITE.githubApp} data-event="github_click" data-section="footer" rel="noopener" target="_blank">{t.footer.github}</a>
      <a href={pathFor(lang, 'press')}>{t.footer.press}</a>
      <a href={SITE.githubIssues} rel="noopener" target="_blank">{t.footer.bug}</a>
      {SITE.coffee && <a href={SITE.coffee} data-event="donate_click" data-section="footer" rel="noopener" target="_blank">{t.footer.donate}</a>}
    </nav>
    <nav class="col" aria-label={t.footer.contact}>
      <strong>{t.footer.contact}</strong>
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      {SITE.youtube && <a href={SITE.youtube} rel="noopener" target="_blank">YouTube</a>}
      {SITE.twitter && <a href={SITE.twitter} rel="noopener" target="_blank">X / Twitter</a>}
      {SITE.mastodon && <a href={SITE.mastodon} rel="me noopener" target="_blank">Mastodon</a>}
    </nav>
  </div>
  <div class="container legal">
    <span>{t.footer.legal}</span>
    <span>{t.footer.honesty}</span>
  </div>
</footer>
<style>
  .footer { border-top: 1px solid var(--border); background: var(--surface); margin-top: 80px; }
  .grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 36px; padding-block: 56px 24px; }
  @media (max-width: 820px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 480px) { .grid { grid-template-columns: 1fr; } }
  .brand { display: flex; flex-direction: column; gap: 14px; align-items: flex-start; }
  .tagline { font-size: 13.5px; line-height: 1.55; color: var(--text2); max-width: 260px; }
  .col { display: flex; flex-direction: column; gap: 10px; font-size: 14px; }
  .col strong { font-size: 13px; letter-spacing: 0.08em; color: var(--text2); text-transform: uppercase; }
  .col a { color: var(--text); text-decoration: none; }
  .col a:hover { color: var(--brand); }
  .legal {
    display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap;
    font-size: 12.5px; color: var(--text2);
    border-top: 1px solid var(--border); padding-block: 18px 28px;
  }
</style>
