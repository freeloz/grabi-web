---
import { SITE } from '../config';
interface Props { label: string; section: string; small?: boolean }
const { label, section, small = false } = Astro.props;
---
<a
  class:list={['btn-primary', { small }]}
  href={SITE.downloadUrl}
  data-event="download_click"
  data-section={section}
  rel="noopener"
>
  {!small && (
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 3 v12 M7 10 l5 5 5 -5" /><path d="M4 19 h16" />
    </svg>
  )}
  {label}
</a>
<style>
  .small { height: 38px; padding: 0 18px; font-size: 14px; box-shadow: none; }
</style>
