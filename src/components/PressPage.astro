---
import { SITE, type Locale } from '../config';
import { dictionaries } from '../i18n';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import Logo from './Logo.astro';
import Mascot from './Mascot.astro';
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = dictionaries[lang];
---
<Nav lang={lang} page="press" />
<main id="main" class="container-narrow page">
  <h1>{t.press.title}</h1>
  <p class="intro">{t.press.intro} <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>

  <a class="btn-primary kit" href="/press/grabi-press-kit.zip" download data-event="presskit_download" data-section="press">{t.press.kit}</a>

  <h2>{t.press.assetsTitle}</h2>
  <div class="assets">
    <figure class="card light"><Logo size={44} /><figcaption>{t.press.logoLight} · <a href="/press/grabi-logo-light.svg" download>SVG</a></figcaption></figure>
    <figure class="card dark"><Logo size={44} /><figcaption>{t.press.logoDark} · <a href="/press/grabi-logo-dark.svg" download>SVG</a></figcaption></figure>
    <figure class="card light"><Mascot pose="neutral" size={64} /><figcaption>{t.press.icon} · <a href="/press/grabi-mascot.svg" download>SVG</a> · <a href="/press/grabi-icon-512.png" download>PNG</a></figcaption></figure>
  </div>

  <h2>{t.press.boilerplateTitle}</h2>
  <blockquote class="card bp">{t.press.boilerplate}</blockquote>

  <h2>{t.press.rulesTitle}</h2>
  <ul class="rules">{t.press.rules.map((r) => <li>{r}</li>)}</ul>
</main>
<Footer lang={lang} page="press" />
<style>
  .page { padding-block: 48px 80px; max-width: 760px; }
  h1 { font-size: clamp(34px, 5vw, 44px); font-weight: 760; margin: 0 0 10px; }
  h2 { font-size: 22px; font-weight: 740; margin: 44px 0 16px; }
  .intro { color: var(--text2); font-size: 16px; margin: 0 0 28px; }
  .kit { font-size: 15px; height: 48px; padding: 0 24px; }
  .assets { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px; }
  figure { margin: 0; padding: 26px 20px; display: flex; flex-direction: column; align-items: center; gap: 14px; text-align: center; }
  figure.dark { background: var(--ink); border-color: var(--ink-border); }
  figure.dark :global(.wm) { color: var(--ivory); }
  figcaption { font-size: 12.5px; color: var(--text2); }
  figure.dark figcaption { color: var(--ivory-dim); }
  .bp { margin: 0; padding: 22px 26px; font-size: 15px; line-height: 1.65; color: var(--text); }
  .rules { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 8px; font-size: 14.5px; line-height: 1.6; color: var(--text2); }
</style>
