# Security + caching for Cloudflare Workers static assets
#
# Nota deliberada sobre la CSP: *.clarity.ms está permitido (analítica de
# producto), pero c.bing.com NO. Ese es el píxel de sincronización de
# identidad cross-site de Microsoft; bloquearlo mantiene la promesa de
# privacidad de Grabi y no afecta las métricas. El error de consola que
# genera es la protección funcionando — no lo "arregles" agregando bing.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://*.clarity.ms https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://*.clarity.ms https://www.google-analytics.com; connect-src 'self' https://api.github.com https://www.google-analytics.com https://*.clarity.ms https://cloudflareinsights.com; frame-ancestors 'none'

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/press/*
  Cache-Control: public, max-age=86400

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
